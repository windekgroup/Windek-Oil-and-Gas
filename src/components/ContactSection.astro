---
import { Phone, Mail, MapPin, Send } from 'lucide-astro';
import { CONTACT } from '../data/site';
---

<section id="contact" class="section-y bg-white">
  <div class="max-w-7xl mx-auto gutter">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
      <div>
        <span class="eyebrow">Get in Touch</span>
        <h2 class="text-display-2 font-bold text-windek-dark mb-5">
          Start a Conversation
        </h2>
        <p class="text-slate-600 leading-relaxed mb-8 max-w-lg">
          Tell us about your project, your capacity requirement or your tender. Our commercial team
          responds to enquiries during Nigerian business hours.
        </p>

        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <span class="w-11 h-11 rounded-lg bg-windek-blue/10 flex items-center justify-center flex-shrink-0">
              <MapPin class="w-5 h-5 text-windek-blue" aria-hidden="true" />
            </span>
            <div>
              <h3 class="font-bold text-windek-dark text-sm mb-1">Head Office</h3>
              <address class="text-sm text-gray-500 not-italic">{CONTACT.address.full}</address>
              <a
                href={CONTACT.mapUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-bold uppercase tracking-widest text-windek-blue hover:text-windek-dark transition-colors mt-1 inline-block"
              >
                Get directions
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span class="w-11 h-11 rounded-lg bg-windek-blue/10 flex items-center justify-center flex-shrink-0">
              <Phone class="w-5 h-5 text-windek-blue" aria-hidden="true" />
            </span>
            <div>
              <h3 class="font-bold text-windek-dark text-sm mb-1">Phone</h3>
              <a
                href={`tel:${CONTACT.phoneHref}`}
                class="text-sm text-gray-500 hover:text-windek-blue transition-colors"
                >{CONTACT.phone}</a
              >
              <p class="text-xs text-gray-400 mt-1">{CONTACT.hours}</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span class="w-11 h-11 rounded-lg bg-windek-blue/10 flex items-center justify-center flex-shrink-0">
              <Mail class="w-5 h-5 text-windek-blue" aria-hidden="true" />
            </span>
            <div>
              <h3 class="font-bold text-windek-dark text-sm mb-1">Email</h3>
              <a
                href={CONTACT.emailHref}
                class="text-sm text-gray-500 hover:text-windek-blue transition-colors break-all"
                >{CONTACT.email}</a
              >
            </div>
          </div>
        </div>
      </div>

      <div class="bg-windek-gray rounded-lg p-6 sm:p-8 lg:p-10">
        <form
          id="contact-form"
          action="https://formsubmit.co/info@windekoilandgasltd.com"
          method="POST"
          class="space-y-5"
        >
          <input type="hidden" name="_subject" value="New enquiry — Windek Oil and Gas Limited" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_next" value="https://windekoilandgasltd.com/thank-you/" />

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="cf-name" class="block text-xs font-bold uppercase tracking-widest text-windek-dark mb-2">
                Full name <span class="text-windek-blue">*</span>
              </label>
              <input
                type="text"
                id="cf-name"
                name="name"
                required
                autocomplete="name"
                class="w-full px-4 py-3 bg-white border border-gray-200 rounded text-sm focus:border-windek-blue focus:ring-2 focus:ring-windek-blue/20 outline-none transition"
              />
            </div>
            <div>
              <label for="cf-company" class="block text-xs font-bold uppercase tracking-widest text-windek-dark mb-2">
                Company
              </label>
              <input
                type="text"
                id="cf-company"
                name="company"
                autocomplete="organization"
                class="w-full px-4 py-3 bg-white border border-gray-200 rounded text-sm focus:border-windek-blue focus:ring-2 focus:ring-windek-blue/20 outline-none transition"
              />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="cf-email" class="block text-xs font-bold uppercase tracking-widest text-windek-dark mb-2">
                Email <span class="text-windek-blue">*</span>
              </label>
              <input
                type="email"
                id="cf-email"
                name="email"
                required
                autocomplete="email"
                class="w-full px-4 py-3 bg-white border border-gray-200 rounded text-sm focus:border-windek-blue focus:ring-2 focus:ring-windek-blue/20 outline-none transition"
              />
            </div>
            <div>
              <label for="cf-phone" class="block text-xs font-bold uppercase tracking-widest text-windek-dark mb-2">
                Phone
              </label>
              <input
                type="tel"
                id="cf-phone"
                name="phone"
                autocomplete="tel"
                class="w-full px-4 py-3 bg-white border border-gray-200 rounded text-sm focus:border-windek-blue focus:ring-2 focus:ring-windek-blue/20 outline-none transition"
              />
            </div>
          </div>

          <div>
            <label for="cf-topic" class="block text-xs font-bold uppercase tracking-widest text-windek-dark mb-2">
              How can we help?
            </label>
            <select
              id="cf-topic"
              name="topic"
              class="w-full px-4 py-3 bg-white border border-gray-200 rounded text-sm focus:border-windek-blue focus:ring-2 focus:ring-windek-blue/20 outline-none transition"
            >
              <option>Upstream operations enquiry</option>
              <option>LPG storage or terminal capacity</option>
              <option>EPCI / engineering project</option>
              <option>Supplier or vendor registration</option>
              <option>Careers</option>
              <option>General enquiry</option>
            </select>
          </div>

          <div>
            <label for="cf-message" class="block text-xs font-bold uppercase tracking-widest text-windek-dark mb-2">
              Message <span class="text-windek-blue">*</span>
            </label>
            <textarea
              id="cf-message"
              name="message"
              rows="5"
              required
              class="w-full px-4 py-3 bg-white border border-gray-200 rounded text-sm focus:border-windek-blue focus:ring-2 focus:ring-windek-blue/20 outline-none transition resize-y"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-windek-blue text-white text-xs font-bold uppercase tracking-widest rounded hover:bg-windek-blue-700 transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
          >
            <span data-label="Send enquiry">
              <Send class="w-4 h-4 mr-2 inline" aria-hidden="true" />Send enquiry
            </span>
          </button>

          <p class="text-xs text-gray-500 leading-relaxed">
            Submissions are delivered directly to our info@windekoilandgasltd.com inbox. We do not
            share your details with third parties.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>