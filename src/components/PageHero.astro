---
export interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const {
  eyebrow,
  title,
  intro,
  image = '/images/about-operations.jpg',
  imageAlt = '',
  imageWidth = 1600,
  imageHeight = 916,
} = Astro.props;
---

<section data-reveal-skip class="relative bg-windek-dark pt-28 sm:pt-32 lg:pt-36 pb-14 sm:pb-20 overflow-hidden">
  <div class="absolute inset-0 z-0">
    <img
      src={image}
      alt={imageAlt}
      width={imageWidth}
      height={imageHeight}
      fetchpriority="high"
      decoding="async"
      class="w-full h-full object-cover opacity-30"
    />
    <span class="absolute inset-0 scrim-left" aria-hidden="true"></span>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto gutter">
    <span class="eyebrow" data-intro style="--intro-step: 0">{eyebrow}</span>
    <h1 class="text-display-1 font-bold text-white max-w-4xl" data-intro style="--intro-step: 1">
      {title}
    </h1>
    {
      intro && (
        <p class="mt-5 sm:mt-6 text-base sm:text-lg text-gray-300 font-light leading-relaxed max-w-3xl border-l-2 border-windek-blue/50 pl-4 sm:pl-6" data-intro style="--intro-step: 2">
          {intro}
        </p>
      )
    }
    <slot />
  </div>
</section>