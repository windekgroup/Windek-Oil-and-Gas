---
import { ChevronDown } from 'lucide-astro';
import type { FaqItem } from '../data/types';

export interface Props {
  items: FaqItem[];
  heading?: string;
  intro?: string;
  idPrefix?: string;
  schemaId?: string;
}

const {
  items,
  heading = 'Frequently Asked Questions',
  intro = 'Straight answers to the questions clients ask us most often.',
  idPrefix = 'faq',
  schemaId,
} = Astro.props;

const schema = schemaId
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      '@id': schemaId,
      mainEntity: items.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;
---

<div>
  <div class="max-w-2xl mb-10 sm:mb-12">
    <h2 class="text-display-3 font-bold text-windek-dark mb-3">
      {heading}
    </h2>
    <p class="text-sm sm:text-base text-slate-600 font-light">{intro}</p>
  </div>

  <div class="space-y-3 max-w-3xl">
    {
      items.map((item, i) => (
        <details id={`${idPrefix}-${i + 1}`} class="group bg-white border border-gray-200 rounded-lg overflow-hidden hover:border-windek-blue/40 transition-colors">
          <summary class="flex items-start justify-between gap-4 p-5 sm:p-6 cursor-pointer list-none font-semibold text-windek-dark hover:text-windek-blue transition-colors">
            <span class="text-sm sm:text-base">{item.question}</span>
            <ChevronDown
              class="w-5 h-5 flex-shrink-0 text-windek-blue mt-0.5 transition-transform group-open:rotate-180"
              aria-hidden="true"
            />
          </summary>
          <div class="px-5 sm:px-6 pb-5 sm:pb-6 -mt-1">
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed prose-windek">{item.answer}</p>
          </div>
        </details>
      ))
    }
  </div>
</div>

{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}