---
import { ArrowRight } from 'lucide-astro';
import { SLOGAN } from '../data/site';

export interface Props {
  heading?: string;
  sub?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  heading = 'Discuss your project with our team',
  sub = SLOGAN,
  primaryLabel = 'Request a Quote',
  primaryHref = '/contact/',
  secondaryLabel = 'Explore Services',
  secondaryHref = '/services/',
} = Astro.props;
---

<section class="py-14 sm:py-16 bg-windek-blue">
  <div class="max-w-7xl mx-auto gutter flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
    <div>
      <p class="text-white/80 text-xs font-bold uppercase tracking-widest mb-2">{sub}</p>
      <h2 class="text-display-3 font-bold text-white">{heading}</h2>
    </div>
    <div class="flex flex-col sm:flex-row gap-3 shrink-0 w-full sm:w-auto">
      <a
        href={primaryHref}
        class="group inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-white text-windek-blue text-xs font-bold uppercase tracking-widest rounded hover:bg-windek-dark hover:text-white transition-[color,background-color,transform] duration-300 ease-out hover:-translate-y-0.5 motion-reduce:hover:translate-y-0"
      >
        {primaryLabel}
        <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" aria-hidden="true" />
      </a>
      <a
        href={secondaryHref}
        class="inline-flex items-center justify-center px-6 py-3.5 border border-white/30 text-white text-xs font-bold uppercase tracking-widest rounded hover:bg-white hover:text-windek-blue transition-colors"
      >
        {secondaryLabel}
      </a>
    </div>
  </div>
</section>