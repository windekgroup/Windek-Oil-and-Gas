---
import { ArrowUp } from 'lucide-astro';
---

<button
  type="button"
  id="scroll-top"
  class="fixed bottom-6 right-6 z-40 w-11 h-11 rounded-full bg-windek-dark text-white shadow-lg hover:bg-windek-blue transition-all opacity-0 pointer-events-none translate-y-3"
  aria-label="Back to top"
>
  <ArrowUp class="w-5 h-5 mx-auto" aria-hidden="true" />
</button>

<script>
  const btn = document.getElementById('scroll-top');
  if (btn) {
    const toggle = () => {
      const show = window.scrollY > 600;
      btn.classList.toggle('opacity-0', !show);
      btn.classList.toggle('pointer-events-none', !show);
      btn.classList.toggle('translate-y-3', !show);
    };
    toggle();
    window.addEventListener('scroll', toggle, { passive: true });
    btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  }
</script>