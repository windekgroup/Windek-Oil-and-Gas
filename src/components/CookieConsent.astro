---
// Cookie choice banner. Analytics is loaded by BaseLayout only after the
// visitor explicitly accepts, so this component does not load any scripts.
---

<div
  id="cookie-consent"
  role="region"
  aria-label="Cookie preferences"
  class="fixed inset-x-0 bottom-0 z-[90] hidden bg-windek-dark text-white border-t border-white/10 shadow-[0_-12px_32px_-16px_rgba(0,0,0,0.6)]"
>
  <div
    class="max-w-7xl mx-auto gutter py-4 sm:py-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
  >
    <p class="text-xs sm:text-sm leading-relaxed text-white/80 max-w-3xl">
      We use analytics cookies to understand how this site is used. No analytics cookies are set
      unless you choose to accept them. Read our
      <a href="/privacy-policy/" class="text-windek-blue underline underline-offset-2">privacy policy</a>.
    </p>
    <div class="flex shrink-0 gap-3">
      <button
        type="button"
        id="cookie-decline"
        class="px-5 py-2.5 rounded border border-white/25 text-xs font-bold uppercase tracking-wider hover:bg-white/10 transition-colors"
      >
        Decline
      </button>
      <button
        type="button"
        id="cookie-accept"
        class="px-5 py-2.5 rounded bg-windek-blue text-white text-xs font-bold uppercase tracking-wider hover:bg-windek-blue-700 transition-colors"
      >
        Accept
      </button>
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = 'windek-cookie-consent';
  const banner = document.getElementById('cookie-consent');
  const acceptButton = document.getElementById('cookie-accept');
  const declineButton = document.getElementById('cookie-decline');

  function getChoice() {
    try {
      return localStorage.getItem(STORAGE_KEY);
    } catch {
      return null;
    }
  }

  function saveChoice(choice: 'accepted' | 'declined') {
    try {
      localStorage.setItem(STORAGE_KEY, choice);
    } catch {
      /* Storage can be unavailable in private browsing; the banner still closes. */
    }
    banner?.classList.add('hidden');
  }

  if (!getChoice()) banner?.classList.remove('hidden');

  acceptButton?.addEventListener('click', () => {
    saveChoice('accepted');
    (window as any).windekLoadAnalytics?.();
  });

  declineButton?.addEventListener('click', () => saveChoice('declined'));
</script>
