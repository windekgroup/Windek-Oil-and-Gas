---
import { ArrowLeft, ArrowRight, Clock, Calendar } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABand from '../../components/CTABand.astro';
import FAQ from '../../components/FAQ.astro';
import { ARTICLES } from '../../data/articles';
import { getTeamMember, SITE_URL } from '../../data/site';
import type { Article } from '../../data/types';

export function getStaticPaths() {
  return ARTICLES.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const author = getTeamMember(article.author);
const related = ARTICLES.filter((a) => a.slug !== article.slug).slice(0, 3);

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-NG', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${SITE_URL}/insights/${article.slug}/#article`,
  headline: article.title,
  description: article.description,
  datePublished: article.date,
  dateModified: article.updated ?? article.date,
  url: `${SITE_URL}/insights/${article.slug}/`,
  mainEntityOfPage: `${SITE_URL}/insights/${article.slug}/`,
  image: `${SITE_URL}/og-image.png`,
  articleSection: article.category,
  keywords: [article.category, 'Nigeria', 'oil and gas', 'LPG', 'energy infrastructure'].join(', '),
  wordCount: article.content.join(' ').split(/\s+/).length,
  author: {
    '@type': 'Person',
    ...(author
      ? {
          '@id': `${SITE_URL}/about/leadership/#${author.slug}`,
          name: author.name,
          jobTitle: author.role,
          image: `${SITE_URL}${author.image}`,
        }
      : { name: 'Windek Oil and Gas Limited' }),
  },
  publisher: { '@id': `${SITE_URL}/#organization` },
  isPartOf: { '@id': `${SITE_URL}/insights/#blog` },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Insights', item: `${SITE_URL}/insights/` },
    {
      '@type': 'ListItem',
      position: 3,
      name: article.title,
      item: `${SITE_URL}/insights/${article.slug}/`,
    },
  ],
};
---

<BaseLayout
  title={article.title}
  description={article.description}
  path={`/insights/${article.slug}/`}
  ogType="article"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Insights', href: '/insights/' },
    { name: article.title, href: `/insights/${article.slug}/` },
  ]}
  jsonLd={[schema, breadcrumbSchema]}
>
  <article>
    <header class="bg-windek-dark pt-28 sm:pt-36 pb-14 sm:pb-16">
      <div class="max-w-4xl mx-auto gutter">
        <a
          href="/insights/"
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-windek-blue hover:text-white transition-colors mb-6"
        >
          <ArrowLeft class="w-4 h-4" aria-hidden="true" />
          All insights
        </a>

        <p class="text-windek-blue text-xs font-bold uppercase tracking-widest mb-3">
          {article.category}
        </p>
        <h1 class="text-display-2 font-bold text-white leading-tight mb-5">
          {article.title}
        </h1>
        <p class="text-gray-300 text-base sm:text-lg font-light leading-relaxed mb-6">
          {article.description}
        </p>

        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-gray-400">
          <span class="flex items-center gap-1.5">
            <Calendar class="w-3.5 h-3.5" aria-hidden="true" />
            <time datetime={article.date}>{formatDate(article.date)}</time>
          </span>
          <span class="flex items-center gap-1.5">
            <Clock class="w-3.5 h-3.5" aria-hidden="true" />
            {article.readingTime}
          </span>
          {
            author && (
              <span class="flex items-center gap-2">
                <img
                  src={author.image}
                  alt=""
                  width={745}
                  height={745}
                  loading="lazy"
                  decoding="async"
                  class="w-6 h-6 rounded-full object-cover"
                />
                {author.name}
              </span>
            )
          }
        </div>
      </div>
    </header>

    <div class="py-16 sm:py-20 bg-white">
      <div class="max-w-4xl mx-auto gutter">
        <div class="prose-windek text-slate-700">
          {article.content.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        {
          article.takeaways.length > 0 && (
            <aside class="mt-10 bg-windek-gray border-l-4 border-windek-blue p-6 sm:p-8 rounded-r-lg">
              <h2 class="text-lg font-bold text-windek-dark mb-4">Key takeaways</h2>
              <ul class="space-y-2.5">
                {article.takeaways.map((t) => (
                  <li class="flex items-start gap-3 text-sm text-gray-700">
                    <span
                      class="w-1.5 h-1.5 rounded-full bg-windek-blue mt-2 flex-shrink-0"
                      aria-hidden="true"
                    />
                    {t}
                  </li>
                ))}
              </ul>
            </aside>
          )
        }

        {
          article.faqs.length > 0 && (
            <div class="mt-14">
              <FAQ
                items={article.faqs}
                heading="Questions on this topic"
                intro="Quick answers to the follow-up questions clients raise most."
                idPrefix="article-faq"
                schemaId={`${SITE_URL}/insights/${article.slug}/#faq`}
              />
            </div>
          )
        }

        {
          author && (
            <div class="mt-14 pt-8 border-t border-gray-200 flex items-start gap-4">
              <img
                src={author.image}
                alt={`${author.name}, ${author.role}`}
                width={745}
                height={745}
                loading="lazy"
                decoding="async"
                class="w-16 h-16 rounded-full object-cover flex-shrink-0"
              />
              <div>
                <p class="text-xs uppercase tracking-widest text-gray-400 mb-1">Written by</p>
                <p class="font-bold text-windek-dark">{author.name}</p>
                <p class="text-sm text-windek-blue font-semibold">{author.role}</p>
                <a
                  href={`/about/leadership/#${author.slug}`}
                  class="text-xs font-bold uppercase tracking-widest text-windek-blue hover:text-windek-dark transition-colors mt-1 inline-block"
                >
                  View profile
                </a>
              </div>
            </div>
          )
        }
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="py-14 sm:py-16 bg-windek-gray">
          <div class="max-w-7xl mx-auto gutter">
            <h2 class="text-2xl font-bold text-windek-dark mb-8 tracking-tight">More insights</h2>
            <div class="grid md:grid-cols-3 gap-6">
              {related.map((item) => (
                <a
                  href={`/insights/${item.slug}/`}
                  class="group bg-white p-6 rounded-lg hover:shadow-lg transition-shadow"
                >
                  <p class="text-xs font-bold uppercase tracking-widest text-windek-blue mb-2">
                    {item.category}
                  </p>
                  <h3 class="font-bold text-windek-dark mb-2 leading-snug group-hover:text-windek-blue transition-colors">
                    {item.title}
                  </h3>
                  <p class="text-sm text-gray-500 line-clamp-2">{item.description}</p>
                  <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-windek-blue mt-4">
                    Read
                    <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" aria-hidden="true" />
                  </span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </article>

  <CTABand heading="Need advice on your own infrastructure?" secondaryLabel="Talk to us" />
</BaseLayout>