---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';
import { TEAM_MEMBERS, SITE_URL } from '../../data/site';

// ItemList only declares ordering. The Person entities themselves are defined
// once, in peopleSchema below, so no @id is described twice on this page.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${SITE_URL}/about/leadership/#leadership`,
  name: 'Windek Oil and Gas Limited Leadership Team',
  itemListElement: TEAM_MEMBERS.map((m, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: { '@id': `${SITE_URL}/about/leadership/#${m.slug}` },
  })),
};

const peopleSchema = {
  '@context': 'https://schema.org',
  '@graph': TEAM_MEMBERS.map((m) => ({
    '@type': 'Person',
    '@id': `${SITE_URL}/about/leadership/#${m.slug}`,
    name: m.name,
    jobTitle: m.role,
    url: `${SITE_URL}/about/leadership/#${m.slug}`,
    image: `${SITE_URL}${m.image}`,
    description: m.bio,
    worksFor: { '@id': `${SITE_URL}/#organization` },
  })),
};
---

<BaseLayout
  title="Leadership Team | Windek Oil and Gas Limited"
  description="Meet the leadership behind Windek Oil and Gas Limited: our operations, business development, human resources and account leaders in Port Harcourt, Nigeria."
  path="/about/leadership/"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'About', href: '/about/' },
    { name: 'Leadership', href: '/about/leadership/' },
  ]}
  jsonLd={[schema, peopleSchema]}
>
  <PageHero
    eyebrow="Leadership"
    title="The People Behind Windek"
    intro="Operations, commercial, people and finance leadership with a shared commitment to indigenous excellence in Nigeria's energy sector."
    image="/images/about-operations.jpg"
    imageAlt="Windek Oil and Gas leadership and operations team"
  />

  <section class="section-y bg-white">
    <div class="max-w-7xl mx-auto gutter">
      <div class="space-y-8 sm:space-y-12">
        {
          TEAM_MEMBERS.map((member) => (
            <article
              id={member.slug}
              class="grid md:grid-cols-[minmax(0,240px)_1fr] gap-6 sm:gap-8 items-start scroll-mt-28 border-b border-gray-100 pb-8 sm:pb-12 last:border-0 last:pb-0"
            >
              <div class="rounded-lg overflow-hidden shadow-lg">
                <img
                  src={member.image}
                  alt={`${member.name}, ${member.role} at Windek Oil and Gas Limited`}
                  width={745}
                  height={745}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-auto object-cover aspect-square"
                />
              </div>
              <div>
                <h2 class="text-display-3 font-bold text-windek-dark mb-1">{member.name}</h2>
                <p class="text-windek-blue text-xs font-bold uppercase tracking-widest mb-4">
                  {member.role}
                </p>
                <p class="text-slate-600 leading-relaxed mb-5 max-w-2xl">{member.bio}</p>
                <div class="border-l-2 border-windek-blue/40 pl-4">
                  <p class="text-xs uppercase tracking-widest text-gray-400 mb-1">Areas of focus</p>
                  <p class="text-sm text-gray-600">{member.focus}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CTABand
    heading="Talk to our leadership team"
    primaryLabel="Contact Us"
    primaryHref="/contact/"
    secondaryLabel="Our Services"
  />
</BaseLayout>